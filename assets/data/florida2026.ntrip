  "tips": [
    {
      "category": "toll",
      "day_number": 0,
      "title": "Trânsito em Orlando e Parques",
      "content": "O trânsito em Orlando é tranquilo fora dos horários de pico das catracas dos parques (evite se deslocar entre 8h–10h e 17h–19h se não for entrar/sair do parque)."
    },
    {
      "category": "toll",
      "day_number": 0,
      "title": "Trânsito em Miami",
      "content": "Miami tem tráfego intenso. Evite rodar nas vias principais nos horários de pico da manhã (7h–9h) e final de tarde (16h–19h)."
    },
    {
      "category": "toll",
      "day_number": 19,
      "title": "Estrada para Key West (Overseas Highway)",
      "content": "Saia cedo de Miami (por volta das 7h) para aproveitar paradas estratégicas como Robert is Here, Blond Giraffe, Robbie's Marina e a Seven Mile Bridge sem pressa."
    },
    {
      "category": "money",
      "day_number": 0,
      "title": "Conta Nomad e Saques em ATM",
      "content": "Se precisar sacar dinheiro em espécie com o cartão Nomad, utilize caixas eletrônicos (ATM) do Bank of America ou Wells Fargo para menores taxas de saque."
    },
    {
      "category": "money",
      "day_number": 0,
      "title": "Cartões e Dinheiro Vivo",
      "content": "Quase 100% dos estabelecimentos aceitam cartão por aproximação ou chip. Mantenha entre $50 e $100 em notas para pequenos estacionamentos, gorjetas ou compras em bancas de beira de estrada."
    },
    {
      "category": "money",
      "day_number": 0,
      "title": "Custo de Pedágios na Flórida",
      "content": "Os pedágios da Florida Turnpike e a rota de Key West somam cerca de $40 a $50 no total da viagem. Verifique a política de SunPass da locadora para não pagar taxas abusivas diárias."
    },
    {
      "category": "shopping",
      "day_number": 0,
      "title": "Compras em Orlando — Lojas de Desconto",
      "content": "Além dos Outlets Premium, aproveite as lojas de departamento com preços excelentes: Ross Dress for Less, Burlington e Marshalls."
    },
    {
      "category": "shopping",
      "day_number": 1,
      "title": "Apple Store para Eletrônicos",
      "content": "Compre o iPhone ou Apple Watch na Apple Store de Boca Raton ou Mall at Millenia em Orlando. Garanta reserva ou horário no app Apple Store para atendimento mais ágil."
    },
    {
      "category": "shopping",
      "day_number": 8,
      "title": "GameStop & Uniqlo",
      "content": "Para colecionáveis, jogos e presentes, visite a GameStop da Semoran Blvd e a flagship da Uniqlo em Disney Springs."
    },
    {
      "category": "dining",
      "day_number": 0,
      "title": "Alimentação Leve antes de Montanhas-Russas",
      "content": "Evite refeições pesadas ou gordurosas antes de encarar parques com montanhas-russas intensas. Prefira cafés da manhã leves (Panera Bread, Dunkin)."
    },
    {
      "category": "dining",
      "day_number": 0,
